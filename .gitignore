# ===========================================================================
# CrossViewNet .gitignore
# ===========================================================================

# ── Python cache ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
.Python
build/
dist/
*.egg-info/
.eggs/

# ── Virtual environments ─────────────────────────────────────────────────────
venv/
env/
.venv/
.env/
ENV/

# ── Jupyter checkpoints ──────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── Local data and run artifacts (never commit) ─────────────────────────────
outputs/
cvpr_subset/
data/
cache/

# Frozen experiment weights / full dump trees (results + code snapshots stay tracked)
experiments/**/checkpoints/
experiments/**/dumps/
experiments/**/gan_checkpoints/
# Phase 2: .pt weights only (GAN dump/ montages ~few MB stay tracked)
experiments/phase2/gan_checkpoints/
experiments/**/runs/**/ckpts/
experiments/**/runs/**/best.pt
experiments/**/runs/**/last.pt

# ── OS-specific ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*~

# ── IDE settings ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ── Archives & binaries ───────────────────────────────────────────────────────
*.zip
*.tar.gz
*.rar
*.7z

# ===========================================================================
# Tracked (do NOT ignore these):
# ──────────────────────────────
#   demo/                  — sample aerial images for quickstart
#   assets/                — README visual assets (comparison strips, etc.)
#   experiments/           — code snapshots + metrics JSON/CSV/logs/showcase + gan dump/ (~MB)
#   cvpr_train.csv / cvpr_val.csv / cvpr_*_v2.csv — path lists only
# ===========================================================================
